{
  "name": "endpoint-permissions-kit",
  "version": "0.3.0",
  "description": "Framework-agnostic endpoint permissions: an instance you create, typed roles and validation hooks",
  "license": "Apache-2.0",
  "author": "yellyoshua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellyoshua/endpoint-permissions-kit.git"
  },
  "bugs": {
    "url": "https://github.com/yellyoshua/endpoint-permissions-kit/issues"
  },
  "homepage": "https://github.com/yellyoshua/endpoint-permissions-kit#readme",
  "keywords": [
    "permissions",
    "authorization",
    "rbac",
    "endpoint",
    "typescript",
    "bun",
    "framework-agnostic"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./types": {
      "types": "./dist/types/types.d.ts",
      "import": "./dist/esm/types.js",
      "require": "./dist/cjs/types.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "clean": "rm -rf dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/typecheck",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  }
}
