{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "endpoint-permissions-kit": [
        "src/index.ts"
      ],
      "endpoint-permissions-kit/types": [
        "src/types.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "tests/*.ts",
    "tests/*.d.ts",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
